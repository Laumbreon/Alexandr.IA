# Copie para .env; preencha apenas com credenciais locais próprias.
NODE_ENV=development
SESSION_SECRET=
# false somente para HTTP local; HTTPS deve usar true.
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
DB_ENV=development
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=alexandria_dev
PGUSER=
PGPASSWORD=
# Para testes de integração use banco separado e DB_ENV=test:
# TEST_DATABASE=alexandria_test

# Circulacao: preencher somente com regras aprovadas pelo responsavel.
# Sem esses valores, retiradas ficam indisponiveis (sem politica presumida).
# LIBRARY_LOAN_DAYS=
# LIBRARY_MAX_LOANS=
# Renovacoes: valores aprovados pelo responsavel; zero no limite desabilita.
# LIBRARY_RENEWAL_DAYS=
# LIBRARY_MAX_RENEWALS=
# Antecedencia de avisos internos (0-365 dias); sem valor, somente atrasos/reservas.
# Definir apenas conforme decisao aprovada. Nenhum canal externo e ativado.
# LIBRARY_NOTICE_DAYS=
